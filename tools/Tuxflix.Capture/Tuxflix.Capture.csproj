<Project Sdk="Microsoft.NET.Sdk">

  <!-- Renders screens of the demo library to PNG files on Avalonia's headless platform, so a
       layout can be looked at without opening a window on anybody's desktop. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="$(AvaloniaVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Tuxflix.App\Tuxflix.App.csproj" />
  </ItemGroup>

</Project>
