<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests that need a real control tree: the application's own styles and views, started on
       Avalonia's headless platform. Kept apart from Tuxflix.Tests so the plain tests do not pay
       for the desktop stack. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="$(TestSdkVersion)" />
    <PackageReference Include="xunit.v3" Version="$(XunitVersion)" />
    <PackageReference Include="xunit.runner.visualstudio" Version="$(XunitRunnerVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Tuxflix.App\Tuxflix.App.csproj" />
  </ItemGroup>

</Project>
