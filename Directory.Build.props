<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Known-vulnerable dependencies, transitive ones included, fail the build. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Tuxflix</Product>
    <Company>Tuxflix</Company>
    <Authors>codingncaffeine</Authors>
    <Copyright>Copyright (C) 2026 Tuxflix contributors</Copyright>
    <VersionPrefix>0.0.5</VersionPrefix>
  </PropertyGroup>

  <!-- Central package versions: bump here and nowhere else. -->
  <PropertyGroup>
    <AvaloniaVersion>12.1.3</AvaloniaVersion>
    <MvvmToolkitVersion>8.4.2</MvvmToolkitVersion>
    <!-- The D-Bus client Avalonia itself ships; pinned to the version it brings, so there is one copy. -->
    <TmdsDbusVersion>0.94.1</TmdsDbusVersion>
    <TestSdkVersion>18.10.1</TestSdkVersion>
    <XunitVersion>3.2.2</XunitVersion>
    <XunitRunnerVersion>3.1.5</XunitRunnerVersion>
  </PropertyGroup>

</Project>
