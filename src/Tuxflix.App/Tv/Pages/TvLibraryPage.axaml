<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tuxflix.App.ViewModels"
             xmlns:views="using:Tuxflix.App.Views"
             xmlns:tv="using:Tuxflix.App.Tv"
             x:Class="Tuxflix.App.Tv.Pages.TvLibraryPage"
             x:DataType="vm:LibraryPageViewModel">

    <!-- A library for a room: its name and size, its views and its order as large buttons, then the
         desktop's grid of tiles drawn larger, so the same rows are built and reused. -->
    <Grid RowDefinitions="Auto,*">
        <Grid Margin="96,128,96,4" ColumnDefinitions="Auto,*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                <TextBlock Classes="tv-heading" Text="{Binding Heading}" />
                <TextBlock Classes="tv-count" Text="{Binding CountText}" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" tv:TvFocus.IsGroup="True">
                <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding HasViews}">
                    <Button Theme="{StaticResource TvButton}" Content="{Binding TitlesLabel}" Classes.selected="{Binding ShowsTitles}"
                            Command="{Binding ShowViewCommand}" CommandParameter="{x:Static vm:LibraryView.Titles}" Padding="22,12" FontSize="18" />
                    <Button Theme="{StaticResource TvButton}" Content="ALBUMS" Classes.selected="{Binding ShowsAlbums}" IsVisible="{Binding IsMusic}"
                            Command="{Binding ShowViewCommand}" CommandParameter="{x:Static vm:LibraryView.Albums}" Padding="22,12" FontSize="18" />
                    <Button Theme="{StaticResource TvButton}" Content="COLLECTIONS" Classes.selected="{Binding ShowsCollections}" IsVisible="{Binding HasCollections}"
                            Command="{Binding ShowViewCommand}" CommandParameter="{x:Static vm:LibraryView.Collections}" Padding="22,12" FontSize="18" />
                </StackPanel>
                <Button Name="SortButton" Theme="{StaticResource TvButton}" Click="OnSort" IsVisible="{Binding HasSorts}" Padding="22,12" FontSize="18">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="SORT" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                        <TextBlock Text="{Binding SortLabel}" />
                    </StackPanel>
                </Button>
                <Button Name="UnwatchedButton" Theme="{StaticResource TvButton}" Click="OnUnwatched" Padding="22,12" FontSize="18"
                        Content="UNWATCHED" IsVisible="False" />
            </StackPanel>
        </Grid>

        <LayoutTransformControl Grid.Row="1" LayoutTransform="scale(1.3)" Margin="50,0,50,0">
            <views:RowsGrid Name="Grid" />
        </LayoutTransformControl>

        <ProgressBar Grid.Row="1" IsIndeterminate="True" IsVisible="{Binding IsLoading}" VerticalAlignment="Top"
                     Height="3" MinHeight="3" Foreground="{DynamicResource Brush.Accent}" Background="Transparent" />

        <TextBlock Grid.Row="1" Classes="tv-body" IsVisible="{Binding IsEmpty}" Text="{Binding EmptyText}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />

        <TextBlock Grid.Row="1" Classes="tv-body" IsVisible="{Binding HasError}" Text="{Binding ErrorMessage}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="800" />
    </Grid>
</UserControl>
