<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tuxflix.App.ViewModels"
             xmlns:tv="using:Tuxflix.App.Tv"
             x:Class="Tuxflix.App.Tv.Pages.TvShelf"
             x:DataType="vm:ShelfViewModel">

    <!-- A shelf for a room: its name large, its tiles larger than the desktop's, a row that keeps
         its place when focus leaves it and comes back. -->
    <StackPanel Spacing="2" tv:TvFocus.IsGroup="True" tv:TvFocus.HoldsEnds="True">
        <StackPanel Name="Heading" Orientation="Horizontal" Spacing="14" Margin="96,0,0,0">
            <TextBlock Classes="tv-shelf" Text="{Binding Title}" />
            <TextBlock Classes="tv-count" Text="{Binding CountText}" VerticalAlignment="Center" />
        </StackPanel>
        <ScrollViewer Name="Row" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
            <LayoutTransformControl LayoutTransform="scale(1.3)">
                <ItemsControl Name="Tiles" ItemsSource="{Binding Tiles}" Margin="74,14,74,24">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="20" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </LayoutTransformControl>
        </ScrollViewer>
    </StackPanel>
</UserControl>
