<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tuxflix.App.ViewModels"
             x:Class="Tuxflix.App.Views.Pages.ComingSoonPage"
             x:DataType="vm:ComingSoonPageViewModel">

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18" MaxWidth="480">
        <Panel Width="96" Height="96" HorizontalAlignment="Center">
            <Border CornerRadius="48" Background="{DynamicResource Brush.Ribbon}" Opacity="0.9" BoxShadow="0 10 40 0 #66A96BEA" />
            <Border CornerRadius="46" Margin="2" Background="{DynamicResource Brush.Panel}" />
            <PathIcon Data="{Binding Icon}" Width="38" Height="38" Foreground="{DynamicResource Brush.Text.Primary}" />
        </Panel>
        <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" />
        <TextBlock Text="{Binding Description}" FontSize="14.5" LineHeight="22" TextWrapping="Wrap" TextAlignment="Center"
                   Foreground="{DynamicResource Brush.Text.Secondary}" />
        <Border Classes="chip" HorizontalAlignment="Center">
            <TextBlock Text="Arrives in a later phase" />
        </Border>
    </StackPanel>
</UserControl>
