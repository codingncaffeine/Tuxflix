<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tuxflix.App.ViewModels"
             xmlns:views="using:Tuxflix.App.Views"
             xmlns:ui="using:Tuxflix.App.Controls"
             x:Class="Tuxflix.App.Views.Pages.CollectionPage"
             x:DataType="vm:CollectionPageViewModel">

    <Grid RowDefinitions="Auto,*">
        <StackPanel Orientation="Horizontal" Spacing="22" Margin="36,28,36,20">
            <Panel Width="88" Height="132">
                <Border CornerRadius="{StaticResource Radius.Tile}" Background="{DynamicResource Brush.Panel}" BoxShadow="{StaticResource Shadow.Tile}" />
                <Border CornerRadius="{StaticResource Radius.Tile}" ClipToBounds="True">
                    <ui:RemoteImage Path="{Binding PosterPath}" DecodeWidth="88" DecodeHeight="132" />
                </Border>
            </Panel>
            <StackPanel VerticalAlignment="Center" Spacing="5" MaxWidth="720">
                <TextBlock Classes="label" Text="COLLECTION" Foreground="{DynamicResource Brush.Accent}" />
                <TextBlock Text="{Binding Heading}" FontSize="30" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding CountText}" Classes="faint" FontSize="13" />
                <TextBlock Text="{Binding Summary}" IsVisible="{Binding HasSummary}" TextWrapping="Wrap" MaxLines="3"
                           FontSize="13.5" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,4,0,0" />
            </StackPanel>
        </StackPanel>

        <Panel Grid.Row="1">
            <views:RowsGrid />
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" VerticalAlignment="Top"
                         Height="2" MinHeight="2" Foreground="{DynamicResource Brush.Accent}" Background="Transparent" />
            <TextBlock IsVisible="{Binding HasError}" Text="{Binding ErrorMessage}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="14" Foreground="{DynamicResource Brush.Text.Secondary}" />
        </Panel>
    </Grid>
</UserControl>
