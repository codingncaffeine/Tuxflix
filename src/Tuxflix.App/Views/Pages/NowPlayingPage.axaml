<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tuxflix.App.ViewModels"
             xmlns:music="using:Tuxflix.App.Music"
             xmlns:ui="using:Tuxflix.App.Controls"
             x:Class="Tuxflix.App.Views.Pages.NowPlayingPage"
             x:DataType="vm:NowPlayingPageViewModel">

    <!-- What is playing, in the light of its own cover: the cover large, the transport under it,
         the queue beside it. -->
    <Panel>
        <Panel IsVisible="{Binding HasBlur}" IsHitTestVisible="False">
            <Border Background="{Binding BlurBottom}" />
            <Border Background="{Binding BlurTop}">
                <Border.OpacityMask>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Offset="0" Color="Black" />
                        <GradientStop Offset="1" Color="Transparent" />
                    </LinearGradientBrush>
                </Border.OpacityMask>
            </Border>
            <Border Background="#80070B18" />
        </Panel>

        <Grid ColumnDefinitions="*,400">
            <!-- ===== The cover, the title and the transport ===== -->
            <Grid RowDefinitions="*,Auto" Margin="44,34,32,34">
                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" MaxWidth="480" MaxHeight="480">
                    <Panel Width="480" Height="480">
                        <Border CornerRadius="12" Background="{DynamicResource Brush.Panel}" BoxShadow="0 34 80 0 #F0020510" />
                        <Border CornerRadius="12" ClipToBounds="True">
                            <Panel>
                                <PathIcon Data="{StaticResource Icon.VinylRecord}" Width="96" Height="96" Foreground="{DynamicResource Brush.Text.Disabled}" />
                                <ui:RemoteImage Path="{Binding Music.ArtPath}" DecodeWidth="960" DecodeHeight="960" />
                            </Panel>
                        </Border>
                        <Border CornerRadius="12" BorderThickness="1" BorderBrush="#26FFFFFF" />
                    </Panel>
                </Viewbox>

                <StackPanel Grid.Row="1" Spacing="14" Margin="0,30,0,0" MaxWidth="720">
                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Music.Title}" FontSize="30" FontWeight="Bold" LetterSpacing="-0.4"
                                   TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                            <Button Theme="{StaticResource GhostButton}" Padding="0" Background="Transparent" BorderThickness="0"
                                    Command="{Binding OpenArtistCommand}" ui:Tip.Text="Open the artist">
                                <TextBlock Text="{Binding Music.Artist}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" />
                            </Button>
                            <TextBlock Text="·" FontSize="16" Classes="faint" VerticalAlignment="Center" />
                            <Button Theme="{StaticResource GhostButton}" Padding="0" Background="Transparent" BorderThickness="0"
                                    Command="{Binding OpenAlbumCommand}" ui:Tip.Text="Open the album">
                                <TextBlock Text="{Binding Music.Album}" FontSize="16" Foreground="{DynamicResource Brush.Text.Secondary}" />
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Text="{Binding Music.PositionText}" FontSize="12.5" Classes="faint" VerticalAlignment="Center" MinWidth="44" />
                        <Slider Grid.Column="1" Name="Seek" Theme="{StaticResource SeekBar}" Margin="12,0"
                                Maximum="{Binding Music.SeekMaximum}" Value="{Binding Music.SeekValue}" AutomationProperties.Name="Position" />
                        <TextBlock Grid.Column="2" Text="{Binding Music.DurationText}" FontSize="12.5" Classes="faint" VerticalAlignment="Center"
                                   MinWidth="44" TextAlignment="Right" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto,*">
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="18">
                            <Button Theme="{StaticResource IconButton}" Classes.toggle-on="{Binding Music.IsShuffled}"
                                    Command="{Binding Music.ToggleShuffleCommand}" ui:Tip.Text="{Binding Music.ShuffleTip}" ui:Tip.Keys="S">
                                <PathIcon Data="{StaticResource Icon.Shuffle}" Width="21" Height="21" />
                            </Button>
                            <Button Theme="{StaticResource IconButton}" Command="{Binding Music.PreviousCommand}" ui:Tip.Text="Previous" ui:Tip.Keys="P">
                                <PathIcon Data="{StaticResource Icon.SkipBack.Fill}" Width="24" Height="24" />
                            </Button>
                            <Button Theme="{StaticResource PlayButton}" Padding="0" Width="62" Height="62" CornerRadius="31"
                                    Command="{Binding Music.TogglePauseCommand}" ui:Tip.Text="{Binding Music.PlayPauseTip}" ui:Tip.Keys="Space">
                                <Panel>
                                    <PathIcon Data="{StaticResource Icon.Play.Fill}" Width="22" Height="22" Foreground="White" Margin="3,0,0,0" IsVisible="{Binding Music.IsPaused}" />
                                    <PathIcon Data="{StaticResource Icon.Pause.Fill}" Width="22" Height="22" Foreground="White" IsVisible="{Binding !Music.IsPaused}" />
                                </Panel>
                            </Button>
                            <Button Theme="{StaticResource IconButton}" Command="{Binding Music.NextCommand}" ui:Tip.Text="Next" ui:Tip.Keys="N">
                                <PathIcon Data="{StaticResource Icon.SkipForward.Fill}" Width="24" Height="24" />
                            </Button>
                            <Button Theme="{StaticResource IconButton}" Classes.toggle-on="{Binding Music.IsRepeating}"
                                    Command="{Binding Music.CycleRepeatCommand}" ui:Tip.Text="{Binding Music.RepeatTip}" ui:Tip.Keys="R">
                                <Panel>
                                    <PathIcon Data="{StaticResource Icon.Repeat}" Width="21" Height="21" IsVisible="{Binding !Music.IsRepeatingOne}" />
                                    <PathIcon Data="{StaticResource Icon.RepeatOnce}" Width="21" Height="21" IsVisible="{Binding Music.IsRepeatingOne}" />
                                </Panel>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="6">
                            <Button Theme="{StaticResource IconButton}" Command="{Binding Music.ToggleMuteCommand}" ui:Tip.Text="Mute" ui:Tip.Keys="M">
                                <Panel>
                                    <PathIcon Data="{StaticResource Icon.SpeakerHigh}" Width="18" Height="18" IsVisible="{Binding !Music.IsMuted}" />
                                    <PathIcon Data="{StaticResource Icon.SpeakerSlash}" Width="18" Height="18" IsVisible="{Binding Music.IsMuted}" />
                                </Panel>
                            </Button>
                            <Slider Theme="{StaticResource SeekBar}" Width="110" Maximum="150" Value="{Binding Music.Volume}"
                                    VerticalAlignment="Center" ui:Tip.Text="Volume" ui:Tip.Keys="Up" AutomationProperties.Name="Volume" />
                            <Button Theme="{StaticResource IconButton}" Command="{Binding Music.ShowCompactPlayerCommand}" Margin="6,0,0,0"
                                    ui:Tip.Text="Compact player, with classic skins">
                                <PathIcon Data="{StaticResource Icon.PictureInPicture}" Width="19" Height="19" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- ===== The queue ===== -->
            <Border Grid.Column="1" Margin="0,24,24,24" CornerRadius="12" Background="#8C0A1024"
                    BorderBrush="{DynamicResource Brush.Line.Hairline}" BorderThickness="1" BoxShadow="{StaticResource Shadow.Raised}">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Classes="shelf-title" Text="QUEUE" Margin="20,18,20,10" />
                    <ListBox Grid.Row="1" ItemsSource="{Binding Music.Queue}" Background="Transparent" Padding="8,0,8,12"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerTheme>
                            <ControlTheme TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                            </ControlTheme>
                        </ListBox.ItemContainerTheme>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="music:QueueEntry">
                                <Button Theme="{StaticResource RailRow}" Padding="8,7" Classes.playing="{Binding IsCurrent}"
                                        Command="{Binding PlayCommand}" ui:Tip.Text="Play this track">
                                    <Button.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuItem Header="Play now" Command="{Binding PlayCommand}" />
                                            <MenuItem Header="Remove from the queue" Command="{Binding RemoveCommand}" />
                                        </MenuFlyout>
                                    </Button.ContextFlyout>
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Panel Width="40" Height="40">
                                            <Border CornerRadius="4" Background="{DynamicResource Brush.Panel}" />
                                            <Border CornerRadius="4" ClipToBounds="True">
                                                <ui:RemoteImage Path="{Binding ArtPath}" DecodeWidth="80" DecodeHeight="80" />
                                            </Border>
                                        </Panel>
                                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Classes="track-title" Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Artist}" FontSize="12" Classes="faint" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="12" Classes="faint" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Panel>
</UserControl>
