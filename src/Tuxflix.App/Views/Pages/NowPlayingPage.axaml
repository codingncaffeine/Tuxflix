<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tuxflix.App.ViewModels"
             xmlns:music="using:Tuxflix.App.Music"
             xmlns:ui="using:Tuxflix.App.Controls"
             xmlns:views="using:Tuxflix.App.Views"
             x:Class="Tuxflix.App.Views.Pages.NowPlayingPage"
             x:DataType="vm:NowPlayingPageViewModel">

    <!-- What is playing, in the light of its own cover: the cover large, the transport under it,
         the queue beside it. -->
    <UserControl.Styles>
        <!-- The line sung is lit; those to come wait half lit, those sung fade back. -->
        <Style Selector="Button.lyric TextBlock.line">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="Opacity" Value="0.42" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.3" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.lyric.past TextBlock.line">
            <Setter Property="Opacity" Value="0.26" />
        </Style>
        <Style Selector="Button.lyric.current TextBlock.line">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.panel-tab TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
        </Style>
        <Style Selector="Button.panel-tab.chosen TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        </Style>
        <Style Selector="Panel#VisualizerChrome">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.3" />
                </Transitions>
            </Setter>
        </Style>
    </UserControl.Styles>

    <Panel>
        <Panel IsVisible="{Binding HasBlur}" IsHitTestVisible="False">
            <Border Background="{Binding BlurBottom}" />
            <Border Background="{Binding BlurTop}">
                <Border.OpacityMask>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Offset="0" Color="Black" />
                        <GradientStop Offset="1" Color="Transparent" />
                    </LinearGradientBrush>
                </Border.OpacityMask>
            </Border>
            <Border Background="#80070B18" />
        </Panel>

        <Grid ColumnDefinitions="*,400" IsVisible="{Binding IsCoverView}">
            <!-- ===== The cover, the title and the transport ===== -->
            <Grid RowDefinitions="*,Auto" Margin="44,34,32,34">
                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" MaxWidth="480" MaxHeight="480">
                    <Panel Width="480" Height="480">
                        <Border CornerRadius="12" Background="{DynamicResource Brush.Panel}" BoxShadow="0 34 80 0 #F0020510" />
                        <Border CornerRadius="12" ClipToBounds="True">
                            <Panel>
                                <PathIcon Data="{StaticResource Icon.VinylRecord}" Width="96" Height="96" Foreground="{DynamicResource Brush.Text.Disabled}" />
                                <ui:RemoteImage Path="{Binding Music.ArtPath}" DecodeWidth="960" DecodeHeight="960" />
                            </Panel>
                        </Border>
                        <Border CornerRadius="12" BorderThickness="1" BorderBrush="#26FFFFFF" />
                    </Panel>
                </Viewbox>

                <StackPanel Grid.Row="1" Spacing="14" Margin="0,30,0,0" MaxWidth="720">
                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Music.Title}" FontSize="30" FontWeight="Bold" LetterSpacing="-0.4"
                                   TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                            <Button Theme="{StaticResource GhostButton}" Padding="0" Background="Transparent" BorderThickness="0"
                                    Command="{Binding OpenArtistCommand}" ui:Tip.Text="Open the artist">
                                <TextBlock Text="{Binding Music.Artist}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" />
                            </Button>
                            <TextBlock Text="·" FontSize="16" Classes="faint" VerticalAlignment="Center" />
                            <Button Theme="{StaticResource GhostButton}" Padding="0" Background="Transparent" BorderThickness="0"
                                    Command="{Binding OpenAlbumCommand}" ui:Tip.Text="Open the album">
                                <TextBlock Text="{Binding Music.Album}" FontSize="16" Foreground="{DynamicResource Brush.Text.Secondary}" />
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Text="{Binding Music.PositionText}" FontSize="12.5" Classes="faint" VerticalAlignment="Center" MinWidth="44" />
                        <Panel Grid.Column="1" Margin="12,0">
                            <Slider Name="Seek" Theme="{StaticResource SeekBar}" IsVisible="{Binding HasPlainSeek}"
                                    Maximum="{Binding Music.SeekMaximum}" Value="{Binding Music.SeekValue}" AutomationProperties.Name="Position" />
                            <!-- The track's shape, from the server's loudness readings, when it has them. -->
                            <views:WaveformSeekBar Name="Waveform" Height="34" VerticalAlignment="Center" IsVisible="{Binding HasWaveform}"
                                                   Levels="{Binding Levels}" Maximum="{Binding Music.SeekMaximum}" Value="{Binding Music.SeekValue}"
                                                   PlayedBrush="{DynamicResource Brush.Accent}" AutomationProperties.Name="Position" />
                        </Panel>
                        <TextBlock Grid.Column="2" Text="{Binding Music.DurationText}" FontSize="12.5" Classes="faint" VerticalAlignment="Center"
                                   MinWidth="44" TextAlignment="Right" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto,*">
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="18">
                            <Button Theme="{StaticResource IconButton}" Classes.toggle-on="{Binding Music.IsShuffled}"
                                    Command="{Binding Music.ToggleShuffleCommand}" ui:Tip.Text="{Binding Music.ShuffleTip}" ui:Tip.Keys="S">
                                <PathIcon Data="{StaticResource Icon.Shuffle}" Width="21" Height="21" />
                            </Button>
                            <Button Theme="{StaticResource IconButton}" Command="{Binding Music.PreviousCommand}" ui:Tip.Text="Previous" ui:Tip.Keys="P">
                                <PathIcon Data="{StaticResource Icon.SkipBack.Fill}" Width="24" Height="24" />
                            </Button>
                            <Button Theme="{StaticResource PlayButton}" Padding="0" Width="62" Height="62" CornerRadius="31"
                                    Command="{Binding Music.TogglePauseCommand}" ui:Tip.Text="{Binding Music.PlayPauseTip}" ui:Tip.Keys="Space">
                                <Panel>
                                    <PathIcon Data="{StaticResource Icon.Play.Fill}" Width="22" Height="22" Foreground="White" Margin="3,0,0,0" IsVisible="{Binding Music.IsPaused}" />
                                    <PathIcon Data="{StaticResource Icon.Pause.Fill}" Width="22" Height="22" Foreground="White" IsVisible="{Binding !Music.IsPaused}" />
                                </Panel>
                            </Button>
                            <Button Theme="{StaticResource IconButton}" Command="{Binding Music.NextCommand}" ui:Tip.Text="Next" ui:Tip.Keys="N">
                                <PathIcon Data="{StaticResource Icon.SkipForward.Fill}" Width="24" Height="24" />
                            </Button>
                            <Button Theme="{StaticResource IconButton}" Classes.toggle-on="{Binding Music.IsRepeating}"
                                    Command="{Binding Music.CycleRepeatCommand}" ui:Tip.Text="{Binding Music.RepeatTip}" ui:Tip.Keys="R">
                                <Panel>
                                    <PathIcon Data="{StaticResource Icon.Repeat}" Width="21" Height="21" IsVisible="{Binding !Music.IsRepeatingOne}" />
                                    <PathIcon Data="{StaticResource Icon.RepeatOnce}" Width="21" Height="21" IsVisible="{Binding Music.IsRepeatingOne}" />
                                </Panel>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="6">
                            <Button Theme="{StaticResource IconButton}" Command="{Binding Music.ToggleMuteCommand}" ui:Tip.Text="Mute" ui:Tip.Keys="M">
                                <Panel>
                                    <PathIcon Data="{StaticResource Icon.SpeakerHigh}" Width="18" Height="18" IsVisible="{Binding !Music.IsMuted}" />
                                    <PathIcon Data="{StaticResource Icon.SpeakerSlash}" Width="18" Height="18" IsVisible="{Binding Music.IsMuted}" />
                                </Panel>
                            </Button>
                            <Slider Theme="{StaticResource SeekBar}" Width="110" Maximum="150" Value="{Binding Music.Volume}"
                                    VerticalAlignment="Center" ui:Tip.Text="Volume" ui:Tip.Keys="Up" AutomationProperties.Name="Volume" />
                            <Button Theme="{StaticResource IconButton}" IsVisible="{Binding HasRadio}" Margin="6,0,0,0"
                                    ui:Tip.Text="Radio from what is playing">
                                <Button.Flyout>
                                    <MenuFlyout ItemsSource="{Binding RadioChoices}" Placement="TopEdgeAlignedRight">
                                        <MenuFlyout.ItemContainerTheme>
                                            <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:MenuChoice">
                                                <Setter Property="Header" Value="{Binding Title}" />
                                                <Setter Property="Command" Value="{Binding ChooseCommand}" />
                                            </ControlTheme>
                                        </MenuFlyout.ItemContainerTheme>
                                    </MenuFlyout>
                                </Button.Flyout>
                                <PathIcon Data="{StaticResource Icon.Radio}" Width="19" Height="19" />
                            </Button>
                            <Button Theme="{StaticResource IconButton}" Command="{Binding ToggleVisualizerCommand}"
                                    ui:Tip.Text="Visualizer, to fill the window" ui:Tip.Keys="V">
                                <PathIcon Data="{StaticResource Icon.Waveform}" Width="19" Height="19" />
                            </Button>
                            <Button Theme="{StaticResource IconButton}" Command="{Binding Music.ShowCompactPlayerCommand}" Margin="6,0,0,0"
                                    ui:Tip.Text="Compact player, with classic skins">
                                <PathIcon Data="{StaticResource Icon.PictureInPicture}" Width="19" Height="19" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- ===== The queue ===== -->
            <Border Grid.Column="1" Margin="0,24,24,24" CornerRadius="12" Background="#8C0A1024"
                    BorderBrush="{DynamicResource Brush.Line.Hairline}" BorderThickness="1" BoxShadow="{StaticResource Shadow.Raised}">
                <Grid RowDefinitions="Auto,*">
                    <!-- The queue, or the lyrics when the track has them and the listener chose them. -->
                    <StackPanel Orientation="Horizontal" Spacing="18" Margin="20,18,20,10">
                        <Button Theme="{StaticResource GhostButton}" Classes="panel-tab" Classes.chosen="{Binding IsQueuePanel}" Padding="0"
                                Background="Transparent" BorderThickness="0" Command="{Binding ShowQueuePanelCommand}">
                            <TextBlock Classes="shelf-title" Text="QUEUE" />
                        </Button>
                        <Button Theme="{StaticResource GhostButton}" Classes="panel-tab" Classes.chosen="{Binding IsLyricsPanel}" Padding="0"
                                Background="Transparent" BorderThickness="0" Command="{Binding ShowLyricsPanelCommand}" IsVisible="{Binding HasLyrics}">
                            <TextBlock Classes="shelf-title" Text="LYRICS" />
                        </Button>
                        <TextBlock Text="{Binding Music.RadioTitle}" IsVisible="{Binding Music.RadioTitle, Converter={x:Static ObjectConverters.IsNotNull}}"
                                   FontSize="12" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="200" />
                    </StackPanel>
                    <ListBox Grid.Row="1" IsVisible="{Binding IsQueuePanel}" ItemsSource="{Binding Music.Queue}" Background="Transparent" Padding="8,0,8,12"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerTheme>
                            <ControlTheme TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                            </ControlTheme>
                        </ListBox.ItemContainerTheme>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="music:QueueEntry">
                                <Button Theme="{StaticResource RailRow}" Padding="8,7" Classes.playing="{Binding IsCurrent}"
                                        Command="{Binding PlayCommand}" ui:Tip.Text="Play this track">
                                    <Button.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuItem Header="Play now" Command="{Binding PlayCommand}" />
                                            <MenuItem Header="Remove from the queue" Command="{Binding RemoveCommand}" />
                                        </MenuFlyout>
                                    </Button.ContextFlyout>
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Panel Width="40" Height="40">
                                            <Border CornerRadius="4" Background="{DynamicResource Brush.Panel}" />
                                            <Border CornerRadius="4" ClipToBounds="True">
                                                <ui:RemoteImage Path="{Binding ArtPath}" DecodeWidth="80" DecodeHeight="80" />
                                            </Border>
                                        </Panel>
                                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Classes="track-title" Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Artist}" FontSize="12" Classes="faint" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="12" Classes="faint" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <ScrollViewer Grid.Row="1" Name="LyricsScroll" IsVisible="{Binding IsLyricsPanel}" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="20,4,20,120">
                            <ItemsControl Name="LyricsList" ItemsSource="{Binding LyricLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LyricLineViewModel">
                                        <Button Theme="{StaticResource GhostButton}" Classes="lyric" Classes.current="{Binding IsCurrent}" Classes.past="{Binding IsPast}"
                                                Padding="0,6" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                Command="{Binding SeekCommand}" ui:Tip.Text="{Binding SeekTip}">
                                            <Panel>
                                                <TextBlock Classes="line" Text="{Binding Text}" TextWrapping="Wrap" FontSize="21" FontWeight="Bold" LineHeight="28" LetterSpacing="-0.2" />
                                                <TextBlock Classes="line" Text="• • •" IsVisible="{Binding IsGap}" FontSize="16" />
                                            </Panel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding LyricsCredit}" Classes="faint" FontSize="11.5" TextWrapping="Wrap" Margin="0,22,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== The visualizer, filling the window; its controls show while the pointer moves ===== -->
        <Panel Name="VisualizerLayer" IsVisible="{Binding IsVisualizerOn}" Background="Black">
            <views:VisualizerView Name="Visualizer" IsVisible="{Binding IsVisualizerOn}" Music="{Binding Music}"
                                  Mode="{Binding VisualizerMode}" Palette="{Binding Palette}" />
            <!-- The top of the picture stands in for the title bar it hides: it moves the window. -->
            <Border Name="VisualizerTitleBand" Height="120" VerticalAlignment="Top" Background="Transparent" />
            <Panel Name="VisualizerChrome">
                <Border Height="120" VerticalAlignment="Top" IsHitTestVisible="False" Background="{DynamicResource Brush.Scrim.Top}" />
                <Border Height="160" VerticalAlignment="Bottom" IsHitTestVisible="False" Background="{DynamicResource Brush.Scrim.Bottom}" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,22,26,0">
                    <Button Theme="{StaticResource IconButton}" ui:Tip.Text="{Binding ModeTip}">
                        <Button.Flyout>
                            <MenuFlyout ItemsSource="{Binding ModeChoices}" Placement="BottomEdgeAlignedRight">
                                <MenuFlyout.ItemContainerTheme>
                                    <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:MenuChoice">
                                        <Setter Property="Header" Value="{Binding Title}" />
                                        <Setter Property="Command" Value="{Binding ChooseCommand}" />
                                        <Setter Property="ToggleType" Value="Radio" />
                                        <Setter Property="IsChecked" Value="{Binding IsChecked}" />
                                    </ControlTheme>
                                </MenuFlyout.ItemContainerTheme>
                            </MenuFlyout>
                        </Button.Flyout>
                        <PathIcon Data="{StaticResource Icon.ChartBar}" Width="20" Height="20" />
                    </Button>
                    <Button Theme="{StaticResource IconButton}" ui:Tip.Text="{Binding PaletteTip}">
                        <Button.Flyout>
                            <MenuFlyout ItemsSource="{Binding PaletteChoices}" Placement="BottomEdgeAlignedRight">
                                <MenuFlyout.ItemContainerTheme>
                                    <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:MenuChoice">
                                        <Setter Property="Header" Value="{Binding Title}" />
                                        <Setter Property="Command" Value="{Binding ChooseCommand}" />
                                        <Setter Property="ToggleType" Value="Radio" />
                                        <Setter Property="IsChecked" Value="{Binding IsChecked}" />
                                    </ControlTheme>
                                </MenuFlyout.ItemContainerTheme>
                            </MenuFlyout>
                        </Button.Flyout>
                        <PathIcon Data="{StaticResource Icon.Palette}" Width="20" Height="20" />
                    </Button>
                    <Button Theme="{StaticResource IconButton}" Name="FullScreenButton" ui:Tip.Text="Full screen" ui:Tip.Keys="F">
                        <PathIcon Data="{StaticResource Icon.CornersOut}" Width="20" Height="20" />
                    </Button>
                    <Button Theme="{StaticResource IconButton}" Command="{Binding ToggleVisualizerCommand}" ui:Tip.Text="Close the visualizer" ui:Tip.Keys="Esc">
                        <PathIcon Data="{StaticResource Icon.X}" Width="20" Height="20" />
                    </Button>
                </StackPanel>
                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Bottom" Margin="32,0,32,30">
                    <Border Width="64" Height="64" CornerRadius="6" ClipToBounds="True" Background="{DynamicResource Brush.Panel}">
                        <ui:RemoteImage Path="{Binding Music.ArtPath}" DecodeWidth="128" DecodeHeight="128" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding Music.Title}" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Music.Artist}" FontSize="14" Foreground="{DynamicResource Brush.Text.Secondary}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="2" Theme="{StaticResource PlayButton}" Padding="0" Width="52" Height="52" CornerRadius="26"
                            Command="{Binding Music.TogglePauseCommand}" ui:Tip.Text="{Binding Music.PlayPauseTip}" ui:Tip.Keys="Space">
                        <Panel>
                            <PathIcon Data="{StaticResource Icon.Play.Fill}" Width="19" Height="19" Foreground="White" Margin="3,0,0,0" IsVisible="{Binding Music.IsPaused}" />
                            <PathIcon Data="{StaticResource Icon.Pause.Fill}" Width="19" Height="19" Foreground="White" IsVisible="{Binding !Music.IsPaused}" />
                        </Panel>
                    </Button>
                </Grid>
            </Panel>
        </Panel>
    </Panel>
</UserControl>
