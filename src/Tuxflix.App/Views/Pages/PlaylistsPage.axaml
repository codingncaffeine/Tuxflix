<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tuxflix.App.ViewModels"
             xmlns:views="using:Tuxflix.App.Views"
             x:Class="Tuxflix.App.Views.Pages.PlaylistsPage"
             x:DataType="vm:PlaylistsPageViewModel">

    <Grid RowDefinitions="Auto,*">
        <StackPanel Margin="36,26,36,14" Spacing="3">
            <TextBlock Classes="page-title" Text="PLAYLISTS" />
            <TextBlock Classes="faint" FontSize="12.5" Text="{Binding CountText}" />
        </StackPanel>

        <Panel Grid.Row="1">
            <views:RowsGrid />
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" VerticalAlignment="Top"
                         Height="2" MinHeight="2" Foreground="{DynamicResource Brush.Accent}" Background="Transparent" />
            <views:EmptyState IsVisible="{Binding IsEmpty}" Icon="{StaticResource Icon.Playlist}"
                              Text="No playlists yet. Make one from any title's menu, under Add to playlist." />
            <views:EmptyState IsVisible="{Binding HasError}" Icon="{StaticResource Icon.WarningCircle}" IsProblem="True"
                              Text="{Binding ErrorMessage}" ActionText="TRY AGAIN" Command="{Binding RetryCommand}" />
        </Panel>
    </Grid>
</UserControl>
