<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tuxflix.App.ViewModels"
             xmlns:ui="using:Tuxflix.App.Controls"
             x:Class="Tuxflix.App.Views.LibraryRail"
             x:DataType="vm:LibraryRailViewModel"
             Width="288">

    <Border Background="{DynamicResource Brush.Rail}" BorderBrush="{DynamicResource Brush.Line.Soft}" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="12,14,8,0">

            <!-- LIBRARY HOME and the grid view, as Steam's rail opens -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,4,0">
                <Button Theme="{StaticResource RailHomeButton}" HorizontalAlignment="Stretch"
                        Classes.selected="{Binding Shell.IsHome}"
                        Command="{Binding Shell.GoHomeCommand}"
                        ui:Tip.Text="Library home" ui:Tip.Keys="Alt+Home">
                    <StackPanel Orientation="Horizontal" Spacing="11">
                        <PathIcon Classes="home-icon" Data="{StaticResource Icon.House.Fill}" Width="15" Height="15" />
                        <TextBlock Text="LIBRARY HOME" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Theme="{StaticResource RailHomeButton}" Padding="12,0" Margin="8,0,0,0"
                        HorizontalContentAlignment="Center"
                        Command="{Binding Shell.ShowDownloadsCommand}"
                        ui:Tip.Text="Downloads">
                    <PathIcon Data="{StaticResource Icon.DownloadSimple}" Width="16" Height="16" />
                </Button>
            </Grid>

            <!-- Which titles are listed -->
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,16,4,8">
                <Button Theme="{StaticResource IconButton}" Padding="6,5" HorizontalAlignment="Left"
                        ui:Tip.Text="Choose which titles the list shows">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource Brush.Accent}" VerticalAlignment="Center" />
                        <TextBlock Classes="rail-header" Text="{Binding FilterLabel}" Foreground="{DynamicResource Brush.Text.Secondary}" />
                        <PathIcon Data="{StaticResource Icon.CaretDown.Bold}" Width="8" Height="8" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuItem Header="All titles" Command="{Binding SetFilterCommand}" CommandParameter="{x:Static vm:RailFilter.All}" />
                            <MenuItem Header="Unwatched" Command="{Binding SetFilterCommand}" CommandParameter="{x:Static vm:RailFilter.Unwatched}" />
                            <MenuItem Header="In progress" Command="{Binding SetFilterCommand}" CommandParameter="{x:Static vm:RailFilter.InProgress}" />
                            <MenuItem Header="Watched" Command="{Binding SetFilterCommand}" CommandParameter="{x:Static vm:RailFilter.Watched}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <TextBox Grid.Row="2" Classes="search rail" Margin="0,0,4,0"
                     Text="{Binding FilterText}" PlaceholderText="Filter titles"
                     AutomationProperties.Name="Filter the titles in the list">
                <TextBox.InnerLeftContent>
                    <PathIcon Data="{StaticResource Icon.MagnifyingGlass}" Width="13" Height="13" Margin="11,0,6,0"
                              Foreground="{DynamicResource Brush.Text.Tertiary}" />
                </TextBox.InnerLeftContent>
            </TextBox>

            <!-- Every library, every title: one virtualised list of headings and rows -->
            <ScrollViewer Grid.Row="3" Margin="-4,8,0,0" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Rows}" Margin="0,0,8,14">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.DataTemplates>
                        <DataTemplate DataType="vm:RailSectionRow">
                            <Button Theme="{StaticResource RailRow}" Margin="0,8,0,2" Padding="8,5"
                                    Command="{Binding ToggleCommand}" ui:Tip.Text="{Binding TipText}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Classes="caret" Classes.collapsed="{Binding !IsExpanded}"
                                              Data="{StaticResource Icon.CaretDown.Bold}" Width="9" Height="9"
                                              Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                    <PathIcon Data="{Binding Icon}" Width="13" Height="13" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                    <TextBlock Classes="rail-header" Text="{Binding Title}" />
                                    <TextBlock Classes="rail-header" Text="{Binding CountText}" Foreground="{DynamicResource Brush.Text.Disabled}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                        <DataTemplate DataType="vm:RailItemRow">
                            <Button Theme="{StaticResource RailRow}" Height="36"
                                    Classes.selected="{Binding IsSelected}"
                                    Command="{Binding OpenCommand}">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Width="21" Height="31" CornerRadius="3" ClipToBounds="True"
                                            Background="{DynamicResource Brush.Panel}" Margin="4,0,0,0">
                                        <ui:RemoteImage Path="{Binding ThumbPath}" DecodeWidth="21" DecodeHeight="31" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="11,0,6,0" FontSize="13"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Classes.watched="{Binding IsWatched}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Trailing}" IsVisible="{Binding HasTrailing}"
                                               FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"
                                               Foreground="{DynamicResource Brush.Accent}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.DataTemplates>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
