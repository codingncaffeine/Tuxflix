<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tuxflix.App.ViewModels"
             xmlns:ui="using:Tuxflix.App.Controls"
             x:Class="Tuxflix.App.Views.Tiles.ExtraTile"
             x:DataType="vm:ExtraTileViewModel">

    <!-- A trailer or featurette: a wide card with its kind, name and length over the still; a click plays it. -->
    <Button Classes="tile" Theme="{StaticResource TileButton}"
            Command="{Binding PlayCommand}"
            AutomationProperties.Name="{Binding AccessibleName}">
        <Panel Width="288" Height="162">
            <Border Name="Lift" CornerRadius="{StaticResource Radius.Card}" Background="{DynamicResource Brush.Panel}" />
            <Border CornerRadius="{StaticResource Radius.Card}" ClipToBounds="True">
                <Panel>
                    <ui:RemoteImage Path="{Binding ImagePath}" DecodeWidth="288" DecodeHeight="162" />
                    <Border Background="{DynamicResource Brush.Scrim.Card}" />
                    <StackPanel VerticalAlignment="Bottom" Margin="14,0,14,13" Spacing="3">
                        <TextBlock Classes="label" Text="{Binding Kind}" Foreground="{DynamicResource Brush.Accent}" />
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding Runtime}" FontSize="11.5" FontWeight="SemiBold" Margin="10,0,0,1"
                                       VerticalAlignment="Bottom" Foreground="#D9EDF1FB" />
                        </Grid>
                    </StackPanel>
                    <Border Classes="reveal" Width="48" Height="48" CornerRadius="24" Margin="0,0,0,30"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="#A6040712" BorderBrush="#80FFFFFF" BorderThickness="1.5" BoxShadow="0 6 18 0 #99020510">
                        <PathIcon Data="{StaticResource Icon.Play.Fill}" Width="17" Height="17" Margin="3,0,0,0" Foreground="White" />
                    </Border>
                </Panel>
            </Border>
            <Border Name="Ring" CornerRadius="{StaticResource Radius.Card}" />
        </Panel>
    </Button>
</UserControl>
