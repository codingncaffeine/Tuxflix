<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tuxflix.App.ViewModels"
             xmlns:ui="using:Tuxflix.App.Controls"
             x:Class="Tuxflix.App.Views.Tiles.PhotoTile"
             x:DataType="vm:PhotoTileViewModel">

    <!-- A square picture: an album's first photo, or the photo itself. -->
    <StackPanel Width="{DynamicResource Tile.Square}" Spacing="9" Margin="0,0,22,26">
        <Button Classes="tile" Theme="{StaticResource TileButton}" Command="{Binding OpenCommand}" ui:ViewerMenu.For="{Binding}"
                AutomationProperties.Name="{Binding Title}" ui:Tip.Text="{Binding OpenTip}">
            <Panel Width="{DynamicResource Tile.Square}" Height="{DynamicResource Tile.Square}">
                <Border Name="Lift" CornerRadius="{StaticResource Radius.Tile}" Background="{DynamicResource Brush.Panel}" />
                <Border CornerRadius="{StaticResource Radius.Tile}" ClipToBounds="True">
                    <Panel>
                        <PathIcon Data="{StaticResource Icon.Image}" Width="44" Height="44" Foreground="{DynamicResource Brush.Text.Disabled}" />
                        <ui:RemoteImage Path="{Binding ThumbPath}" DecodeWidth="{DynamicResource Tile.Square}" DecodeHeight="{DynamicResource Tile.Square}" Stretch="UniformToFill" />
                    </Panel>
                </Border>
                <Border IsVisible="{Binding IsAlbum}" CornerRadius="0,0,8,8" VerticalAlignment="Bottom" Height="34"
                        Background="{DynamicResource Brush.Scrim.Card}">
                    <PathIcon Data="{StaticResource Icon.FolderSimple}" Width="15" Height="15" HorizontalAlignment="Left" Margin="10,0,0,0" Foreground="White" />
                </Border>
                <Border Name="Ring" CornerRadius="{StaticResource Radius.Tile}" />
            </Panel>
        </Button>
        <StackPanel Spacing="2">
            <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Caption}" FontSize="12" Classes="faint" />
        </StackPanel>
    </StackPanel>
</UserControl>
