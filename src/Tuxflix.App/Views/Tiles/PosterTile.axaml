<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tuxflix.App.ViewModels"
             xmlns:ui="using:Tuxflix.App.Controls"
             x:Class="Tuxflix.App.Views.Tiles.PosterTile"
             x:DataType="vm:PosterTileViewModel">

    <!-- The capsule: art only at rest; on hover it lifts, its shadow deepens, a hairline ring
         appears and the title rises out of a scrim. -->
    <Button Classes="tile" Theme="{StaticResource TileButton}"
            Command="{Binding OpenCommand}" ui:ViewerMenu.For="{Binding}"
            AutomationProperties.Name="{Binding AccessibleName}">
        <Panel Width="164" Height="246">
            <Border Name="Lift" CornerRadius="{StaticResource Radius.Tile}" Background="{DynamicResource Brush.Panel}" />
            <Border CornerRadius="{StaticResource Radius.Tile}" ClipToBounds="True">
                <Panel>
                    <!-- Seen while the artwork loads, and for good when the item has none. -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" Margin="14">
                        <PathIcon Data="{StaticResource Icon.FilmSlate}" Width="26" Height="26"
                                  Foreground="{DynamicResource Brush.Text.Disabled}" />
                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" TextAlignment="Center" FontSize="13"
                                   FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                    </StackPanel>
                    <ui:RemoteImage Path="{Binding ImagePath}" DecodeWidth="164" DecodeHeight="246" />
                    <Border Classes="reveal" Background="{DynamicResource Brush.Scrim.Bottom}" />
                    <StackPanel Classes="reveal" VerticalAlignment="Bottom" Margin="11,0,11,14" Spacing="2">
                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Subtitle}" FontSize="11.5" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                    </StackPanel>
                    <ProgressBar Theme="{StaticResource ThinProgress}" VerticalAlignment="Bottom"
                                 Value="{Binding Progress}" IsVisible="{Binding HasProgress}" />
                </Panel>
            </Border>
            <Border Name="Ring" CornerRadius="{StaticResource Radius.Tile}" />
            <Border Classes="badge-new" IsVisible="{Binding IsNew}"><TextBlock Text="NEW" /></Border>
            <Border Classes="badge-count" IsVisible="{Binding HasUnwatchedCount}"><TextBlock Text="{Binding UnwatchedText}" /></Border>
            <Border Classes="badge-watched" IsVisible="{Binding IsWatched}">
                <PathIcon Data="{StaticResource Icon.Check.Bold}" Width="10" Height="10" Foreground="White" />
            </Border>
        </Panel>
    </Button>
</UserControl>
