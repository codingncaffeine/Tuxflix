<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tuxflix.App.ViewModels"
             xmlns:ui="using:Tuxflix.App.Controls"
             x:Class="Tuxflix.App.Views.SubtitleFinderView"
             x:DataType="vm:SubtitleFinderViewModel"
             Width="400">
    <StackPanel Spacing="10">
        <TextBlock Text="Find subtitles online" FontSize="15" FontWeight="SemiBold" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <ComboBox ItemsSource="{Binding Source={x:Static vm:SubtitleFinderViewModel.Languages}}" SelectedItem="{Binding Language}"
                      HorizontalAlignment="Stretch" ui:Tip.Text="The language to look for" />
            <Button Grid.Column="1" Theme="{StaticResource GhostButton}" Padding="14,7" Command="{Binding SearchCommand}"
                    ui:Tip.Text="Look again">
                <PathIcon Data="{StaticResource Icon.MagnifyingGlass}" Width="16" Height="16" />
            </Button>
        </Grid>
        <TextBlock Text="{Binding Status}" IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   FontSize="12.5" Classes="faint" TextWrapping="Wrap" />
        <ScrollViewer MaxHeight="300" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Results}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FoundSubtitle">
                        <Button Theme="{StaticResource RailRow}" Padding="8,6" Margin="0,0,0,2" Command="{Binding AddCommand}"
                                ui:Tip.Text="Keep this one with the item and turn it on">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Detail}" FontSize="12" Classes="faint" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <TextBlock Text="The one you choose is kept with this item on your server, for everyone who watches it."
                   FontSize="11.5" Classes="faint" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
