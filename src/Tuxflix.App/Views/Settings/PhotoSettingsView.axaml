<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tuxflix.App.ViewModels"
             x:Class="Tuxflix.App.Views.Settings.PhotoSettingsView"
             x:DataType="vm:PhotoSettingsViewModel">

    <!-- Photos: the slideshow's pace and order. -->
    <StackPanel Spacing="16" MaxWidth="640" HorizontalAlignment="Left">
        <TextBlock Classes="shelf-title" Text="PHOTOS" />
        <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto" RowSpacing="12">
            <TextBlock Text="Slideshow, seconds a photo" VerticalAlignment="Center" />
            <NumericUpDown Grid.Column="1" Width="140" HorizontalAlignment="Left" Minimum="2" Maximum="60" Increment="1" FormatString="0"
                           Value="{Binding SlideshowSeconds}" AutomationProperties.Name="Slideshow seconds a photo" />
            <TextBlock Grid.Row="1" Text="Order" VerticalAlignment="Center" />
            <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding SlideshowShuffle}" Content="Shuffle slideshows" />
        </Grid>
    </StackPanel>
</UserControl>
